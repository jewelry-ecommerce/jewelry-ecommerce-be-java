# EXAMPLE ONLY. Never commit real secrets; configure these in Render Environment.
SPRING_PROFILES_ACTIVE=cloud
# Use the direct Neon JDBC connection, not the pooled -pooler host, for Flyway.
DB_URL=jdbc:postgresql://YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=require
DB_USERNAME=
DB_PASSWORD=
# Stable RSA keys: PKCS#8 private / X.509 public. Paste PEM as multiline values.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
CORS_ALLOWED_ORIGINS=https://jewelry-ecommerce-admin.vercel.app,https://jewelry-ecommerce-client.vercel.app
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jewelry-commerce
# Optional override; Render supplies RENDER_EXTERNAL_URL automatically. No /api/v1.
# UPLOAD_PUBLIC_BASE_URL=https://YOUR-ACTUAL-SERVICE.onrender.com

# AI Stylist (Gemini). Placeholders only — leave the key empty until you set a real one in Render.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT=3s
AI_MAX_CANDIDATES=24
AI_MIN_RECOMMENDATIONS=3
AI_MAX_RECOMMENDATIONS=6
AI_MIN_SET_ITEMS=2
AI_MAX_SET_ITEMS=6
AI_HISTORY_LIMIT=20
AI_BUDGET_TOLERANCE_RATIO=0.10
AI_MAX_CONCURRENT_CALLS=2
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_INPUT_CHARS=6000

# Demo checkout needs no VNPay registration: the browser pays on our own page and no money moves.
# Real Sandbox: set VNPAY_DEMO_MODE=false, put Terminal ID and Hash Secret from
# https://sandbox.vnpayment.vn/devreg into VNPAY_TMN_CODE and VNPAY_HASH_SECRET, and register the
# same Return URL and IPN URL there. Do not put production / live keys here.
# IPN must be a public HTTPS URL only when demo-mode is false.
VNPAY_ENABLED=true
VNPAY_DEMO_MODE=true
VNPAY_TMN_CODE=DEMO
VNPAY_HASH_SECRET=jewelry-vnpay-demo-only
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://jewelry-ecommerce-client.vercel.app/thanh-toan-vnpay
VNPAY_IPN_URL=https://jewelry-ecommerce-be-java.onrender.com/api/v1/storefront/payment/vnpay/ipn
VNPAY_CLIENT_BASE_URL=https://jewelry-ecommerce-client.vercel.app
VNPAY_TIMEOUT=15m
