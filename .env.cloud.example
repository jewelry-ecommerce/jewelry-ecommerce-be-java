# EXAMPLE ONLY. Never commit real secrets; configure these in Render Environment.
SPRING_PROFILES_ACTIVE=cloud
# Use the direct Neon JDBC connection, not the pooled -pooler host, for Flyway.
DB_URL=jdbc:postgresql://YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=require
DB_USERNAME=
DB_PASSWORD=
# Stable RSA keys: PKCS#8 private / X.509 public. Paste PEM as multiline values.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
CORS_ALLOWED_ORIGINS=https://jewelry-ecommerce-admin.vercel.app,https://jewelry-ecommerce-client.vercel.app
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jewelry-commerce
# Optional override; Render supplies RENDER_EXTERNAL_URL automatically. No /api/v1.
# UPLOAD_PUBLIC_BASE_URL=https://YOUR-ACTUAL-SERVICE.onrender.com

# Optional MoMo Sandbox. No real-money gateway; disabled until your own Test keys are set.
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=https://jewelry-ecommerce-client.vercel.app/thanh-toan-momo
MOMO_IPN_URL=https://jewelry-ecommerce-be-java.onrender.com/api/v1/storefront/payment/momo/ipn
MOMO_TIMEOUT=30s

# AI Stylist (Gemini). Placeholders only — leave the key empty until you set a real one in Render.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT=3s
AI_MAX_CANDIDATES=24
AI_MIN_RECOMMENDATIONS=3
AI_MAX_RECOMMENDATIONS=6
AI_MIN_SET_ITEMS=2
AI_MAX_SET_ITEMS=6
AI_HISTORY_LIMIT=20
AI_BUDGET_TOLERANCE_RATIO=0.10
AI_MAX_CONCURRENT_CALLS=2
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_INPUT_CHARS=6000
