# EXAMPLE ONLY. Never commit real secrets; configure these in Render Environment.
SPRING_PROFILES_ACTIVE=cloud
# Use the direct Neon JDBC connection, not the pooled -pooler host, for Flyway.
DB_URL=jdbc:postgresql://YOUR-DIRECT-HOST.neon.tech/neondb?sslmode=require
DB_USERNAME=
DB_PASSWORD=
# Stable RSA keys: PKCS#8 private / X.509 public. Paste PEM as multiline values.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
CORS_ALLOWED_ORIGINS=https://jewelry-ecommerce-admin.vercel.app,https://jewelry-ecommerce-client.vercel.app
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=jewelry-commerce
# Optional override; Render supplies RENDER_EXTERNAL_URL automatically. No /api/v1.
# UPLOAD_PUBLIC_BASE_URL=https://YOUR-ACTUAL-SERVICE.onrender.com

# OTP demo (Seva-style): UI vẫn SĐT, forward mã về 1 mail — Resend free, không SMS.
# Đăng ký https://resend.com bằng đúng mail nhận OTP → API Keys → paste RESEND_API_KEY.
# Với from onboarding@resend.dev, Resend chỉ cho gửi TỚI email đã đăng ký tài khoản.
OTP_FORWARD_EMAIL=tieuphu142003@gmail.com
RESEND_API_KEY=
# OTP_RESEND_FROM=Jewelry OTP <onboarding@resend.dev>

# AI Stylist (Gemini). Placeholders only — leave the key empty until you set a real one in Render.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_TEMPERATURE=0.2
AI_PROMPT_CACHE_KEY=jewelry-shop-assistant
AI_PROMPT_CACHE_RETENTION=in_memory
AI_ASSISTANT_MAX_TOOL_ROUNDS=1
AI_MODEL=gemini-3.5-flash-lite
AI_ASSISTANT_MODEL=gemini-3.1-pro-preview
AI_CURRENT_MODEL=gemini-3.1-pro-preview
AI_ASSISTANT_THINKING_LEVEL=HIGH
AI_ASSISTANT_MAX_OUTPUT_TOKENS=8192
AI_ASSISTANT_TIMEOUT=60s
AI_TIMEOUT=3s
AI_MAX_CANDIDATES=24
AI_MIN_RECOMMENDATIONS=3
AI_MAX_RECOMMENDATIONS=6
AI_MIN_SET_ITEMS=2
AI_MAX_SET_ITEMS=6
AI_HISTORY_LIMIT=20
AI_BUDGET_TOLERANCE_RATIO=0.10
AI_MAX_CONCURRENT_CALLS=2
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_INPUT_CHARS=6000
AI_TRYON_IMAGE_MODEL=gemini-3.1-flash-image
AI_TRYON_TIMEOUT=90s
AI_TRYON_MAX_VARIANTS=1
AI_TRYON_MAX_UPLOAD_BYTES=5242880

# PayOS keys from https://my.payos.vn after personal/business verification and a payment channel.
# Register webhook URL on the PayOS dashboard to the webhook path below. Test transfers are real money.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_ENDPOINT=https://api-merchant.payos.vn/v2/payment-requests
PAYOS_RETURN_URL=https://jewelry-ecommerce-be-java.onrender.com/api/v1/storefront/payment/payos/return
PAYOS_CANCEL_URL=https://jewelry-ecommerce-be-java.onrender.com/api/v1/storefront/payment/payos/cancel
PAYOS_CLIENT_BASE_URL=https://jewelry-ecommerce-client.vercel.app
