# Sao chép thành .env (hoặc dùng gen-secrets.sh để tự sinh). KHÔNG commit file .env.
DOMAIN=api.example.com
POSTGRES_DB=kltn_ecommerce
POSTGRES_USER=kltn
POSTGRES_PASSWORD=doi-mat-khau-manh
# Khoá RSA ký JWT, mỗi khoá nằm trên MỘT dòng (phần base64, không cần dòng BEGIN/END). Sinh bằng gen-secrets.sh.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Các địa chỉ FE được phép gọi API, cách nhau dấu phẩy, không có dấu / ở cuối.
CORS_ALLOWED_ORIGINS=https://jewelry-ecommerce-client.vercel.app
JAVA_OPTS="-XX:MaxRAMPercentage=70 -Duser.timezone=Asia/Ho_Chi_Minh"
