# Sao chép thành .env (hoặc dùng gen-secrets.sh để tự sinh). KHÔNG commit file .env.
DOMAIN=api.example.com
POSTGRES_DB=kltn_ecommerce
POSTGRES_USER=kltn
POSTGRES_PASSWORD=doi-mat-khau-manh
# Khoá RSA ký JWT, mỗi khoá nằm trên MỘT dòng (phần base64, không cần dòng BEGIN/END). Sinh bằng gen-secrets.sh.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Các địa chỉ FE được phép gọi API, cách nhau dấu phẩy, không có dấu / ở cuối.
CORS_ALLOWED_ORIGINS=https://jewelry-ecommerce-client.vercel.app
JAVA_OPTS="-XX:MaxRAMPercentage=70 -Duser.timezone=Asia/Ho_Chi_Minh"
# AI Stylist (Gemini). Để trống key và AI_ENABLED=false thì dùng gợi ý cơ bản. Không commit key thật.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Chat Completions (OpenAI / LiteLLM / Gemini OpenAI-compat). Đổi base này sang proxy LiteLLM nếu chạy LiteLLM.
AI_CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_TEMPERATURE=0.2
AI_PROMPT_CACHE_KEY=jewelry-shop-assistant
AI_PROMPT_CACHE_RETENTION=in_memory
AI_ASSISTANT_MAX_TOOL_ROUNDS=1
AI_MODEL=gemini-3.5-flash-lite
AI_ASSISTANT_MODEL=gemini-3.1-pro-preview
AI_CURRENT_MODEL=gemini-3.1-pro-preview
AI_ASSISTANT_THINKING_LEVEL=HIGH
AI_ASSISTANT_TIMEOUT=60s
AI_ASSISTANT_MAX_OUTPUT_TOKENS=8192
AI_TIMEOUT=3s
AI_MAX_CANDIDATES=24
AI_MIN_RECOMMENDATIONS=3
AI_MAX_RECOMMENDATIONS=6
AI_MIN_SET_ITEMS=2
AI_MAX_SET_ITEMS=6
AI_HISTORY_LIMIT=20
AI_BUDGET_TOLERANCE_RATIO=0.10
AI_MAX_CONCURRENT_CALLS=2
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_INPUT_CHARS=6000
# Public MoMo test partner from MoMo's published sample. Replace with a real partner before production.
# IPN and redirect must be public HTTPS on the deployed API. Do not point IPN at localhost in production.
MOMO_ENABLED=true
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://api.example.com/api/v1/storefront/payment/momo/return
MOMO_IPN_URL=https://api.example.com/api/v1/storefront/payment/momo/ipn
MOMO_CLIENT_BASE_URL=https://jewelry-ecommerce-client.vercel.app
