# Sao chép thành .env (hoặc dùng gen-secrets.sh để tự sinh). KHÔNG commit file .env.
DOMAIN=api.example.com
POSTGRES_DB=kltn_ecommerce
POSTGRES_USER=kltn
POSTGRES_PASSWORD=doi-mat-khau-manh
# Khoá RSA ký JWT, mỗi khoá nằm trên MỘT dòng (phần base64, không cần dòng BEGIN/END). Sinh bằng gen-secrets.sh.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Các địa chỉ FE được phép gọi API, cách nhau dấu phẩy, không có dấu / ở cuối.
CORS_ALLOWED_ORIGINS=https://jewelry-ecommerce-client.vercel.app
JAVA_OPTS="-XX:MaxRAMPercentage=70 -Duser.timezone=Asia/Ho_Chi_Minh"
# AI Stylist (Gemini). Để trống key và AI_ENABLED=false thì dùng gợi ý cơ bản. Không commit key thật.
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT=3s
AI_MAX_CANDIDATES=24
AI_MIN_RECOMMENDATIONS=3
AI_MAX_RECOMMENDATIONS=6
AI_MIN_SET_ITEMS=2
AI_MAX_SET_ITEMS=6
AI_HISTORY_LIMIT=20
AI_BUDGET_TOLERANCE_RATIO=0.10
AI_MAX_CONCURRENT_CALLS=2
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_INPUT_CHARS=6000
